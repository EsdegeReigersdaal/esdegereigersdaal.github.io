model {
    esdege = organization 'Esdege-Reigersdaal' {

        /*
        Section for actors
        */
        confluxdb_engineer = actor 'ConfluxDB Team' {
            description 'SREs & Data Engineers'
        }
        planning_and_control = actor 'Planning & Control' {
            description 'Business Analysts'
        }
        esdege_employees = actor 'Other Departments' {
            style {
                size small
            }
            description 'Stakeholders Esdege-Reigersdaal'
            style {
                color muted
            }
        }
        it_department = actor 'Tech Support' {
            style {
                size small
            }
            description 'Second line tech support'
        }

        /*
        Section for actor relations
        */
        planning_and_control -> confluxdb_engineer 'Requests data pipelines from'
        esdege_employees -> confluxdb_engineer 'Requests data pipelines from'
        esdege_employees -> planning_and_control 'Requests business intelligence from'

        it_department -> esdege_azure_cloud 'Manages'

        planning_and_control -> esdege_azure_cloud 'Works in'
        confluxdb_engineer -> esdege_azure_cloud 'Works in'

        /*
        Section for internal component
        */
        esdege_azure_cloud = system 'Esdege-Reigersdaal Azure Cloud Tenant'{
            style {
                size:xl
                icon tech:azure
            }
        }
    }
    
        /*
        Section for external components
        */
        external_data_sources = external 'External Systems' {
            description 'Available APIs'
            style {
                color gray
            }
        }

        /*
        Section for external connections
        */
        esdege_azure_cloud -> external_data_sources 'Sends data to'
        external_data_sources -> esdege_azure_cloud 'Sends data to'

}

