specification {
  element actor {
    notation 'Person, Esdege-Staff'
    style {
      color sky
      shape person
    }   
  }
  element system {
    style {
        opacity 15%
    }
  }

  element external {
    style {
        color red
    }
  }
  element component {
    style {
      color muted
      opacity 15%
    }
  }
  element organization {
    style {
      opacity 15%
    }
  }
}
